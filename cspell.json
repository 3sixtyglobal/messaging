{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"autorelease",
		"authcallback",
		"authenticationfailed",
		"hotfixes",
		"GOCSPX",
		"googleusercontent",
		"greenmail",
		"imapflow",
		"htpasswd",
		"nameof",
		"RETR",
		"sesv",
		"UIDL",
		"uidl",
		"Uidl",
		"seenUidls",
		"serverUidls",
		"STARTTLS",
		"Stiftung"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm"
	]
}
