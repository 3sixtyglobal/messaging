{
	"name": "@twin.org/mailbox-connector-outlook",
	"version": "0.10.1-next.1",
	"description": "Outlook connector for email mailbox ingestion.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-messaging.git",
		"directory": "packages/mailbox-connector-outlook"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@azure/msal-node": "6.0.1",
		"@microsoft/microsoft-graph-client": "3.0.7",
		"@twin.org/background-task-models": "next",
		"@twin.org/core": "next",
		"@twin.org/entity": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/mailbox-models": "0.10.1-next.1",
		"@twin.org/nameof": "next"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"copyfiles": "2.4.1",
		"dotenv": "18.0.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"messaging",
		"mailbox",
		"email",
		"outlook",
		"microsoft",
		"graph",
		"oauth",
		"connector"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-messaging/issues"
	},
	"homepage": "https://twindev.org"
}
