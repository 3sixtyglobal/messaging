# Gmail has no local emulator, so the unit tests mock the Gmail API and need no configuration.
# Copy these into tests/.env.dev and fill them in to run the live suite against a real mailbox.
# Only the OAuth client and mailbox address are needed, the live suite drives the consent flow.
# TEST_GMAIL_EMAIL_ADDRESS=
# TEST_GMAIL_CLIENT_ID=
# TEST_GMAIL_CLIENT_SECRET=
#
# The live suite is interactive, it opens a browser and waits for consent, so set this to run it
# and remove it again to keep npm run dist unattended.
# TEST_GMAIL_LIVE=true
